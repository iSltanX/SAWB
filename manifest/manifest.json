{
  "manifest_version": 3,
  "name": "صَوْب — SAWB",
  "version": "1.1.0",
  "description": "إضافة تضبط اتجاه الكتابة تلقائيًا بين RTL وLTR داخل حقول النص والمحتوى المعروض. تعمل محليًا بلا حساب أو خادم.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "صَوْب — SAWB",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": ["storage"],
  "commands": {
    "set-rtl": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "تبديل الاتجاه إلى RTL"
    },
    "set-ltr": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "تبديل الاتجاه إلى LTR"
    },
    "set-auto": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "تفعيل الوضع التلقائي"
    },
    "toggle-temp-disable": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "تعطيل الإضافة مؤقتًا"
    }
  }
}
